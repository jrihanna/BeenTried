# Copy to .env and fill in what you need. Everything is optional for local dev.

# Port the server listens on.
PORT=3000

# The site's public address, e.g. https://tarpit.example.com. Needed in production behind a proxy.
PUBLIC_URL=

# Leave empty to use the built-in embedded Postgres (PGlite) stored in ./.data.
# Set it to use a real Postgres with pgvector, e.g. the one in docker-compose.yml:
# DATABASE_URL=postgres://tarpit:tarpit@localhost:5432/tarpit
DATABASE_URL=

# Used to hash IP addresses and visitor ids. Set a long random string in production.
SESSION_SECRET=change-me

# Enables semantic matching and AI explanations in the idea checker.
# Without it the checker falls back to keyword matching.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1

# Turns on /admin (comment moderation, marking entries reviewed). Leave empty to disable.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Reports on companies in "Who tried". A report hides the company immediately until you review it in /admin.
# Where to tell you about new reports: a Slack or Discord incoming webhook URL. Leave empty to only log them.
REPORT_WEBHOOK_URL=
# Site-wide cap on how many companies reports can hide per hour. Past it, reports still queue but don't hide.
REPORT_AUTOHIDE_PER_HOUR=20
# Complaints and privacy contact, shown on report forms, the footer, About and the privacy page.
COMPLAINTS_EMAIL=

# Show unreviewed (draft) entries to visitors? Defaults to yes in development and no when NODE_ENV=production.
# Drafts can always be previewed from /admin.
# PUBLISH_DRAFTS=false
